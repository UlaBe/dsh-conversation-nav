{
  "name": "@ulabe/dsh-conversation-nav",
  "description": "Conversation position navigator (flat list): a right-edge tick rail with a hover panel listing every user message, click to jump (DeepSeek web-style).",
  "version": "0.2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "conversation",
    "navigation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
